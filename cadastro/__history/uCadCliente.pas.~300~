procedure TfrmCadCliente.edtTelefoneChange(Sender: TObject);
var
  Num, Texto: string;
begin
  Num := SomenteNumeros(edtTelefone.Text);
  Texto := ''; //começa vazio

  edtTelefone.OnChange := nil; //desligando o  evento temporariamente

  //tipo 0400,0800 e etc
  if (Length(Num) >= 4) and (Num[1] = '0') and (Num[2] in ['1'..'9']) and (Num[3] = '0') and (Num[4] = '0') then
  begin
    if Length(Num) >= 1 then
      Texto := Copy(Num,1,4);

    if Length(Num) >= 5 then
      Texto := Texto + ' ' + Copy(Num,5,3);

    if Length(Num) >= 8 then
      Texto := Texto + ' ' + Copy(Num,8,4);
  end

  // tipo celular
  else if Length(Num) = 11 then
  begin
    Texto := '(' + Copy(Num,1,2) + ') ' +
             Copy(Num,3,5) + '-' +
             Copy(Num,8,4);
  end

  // tipo fixo
  else
  begin
    if Length(Num) >= 1 then
      Texto := '(' + Copy(Num,1,2);

    if Length(Num) >= 3 then
      Texto := Texto + ') ' + Copy(Num,3,4);

    if Length(Num) >= 7 then
      Texto := Texto + '-' + Copy(Num,7,4);
  end;

  edtTelefone.Text := Texto;  //texto já formatado
  edtTelefone.SelStart := Length(Texto); //cursor no final do texto

  edtTelefone.OnChange := edtTelefoneChange; //liga o evento dnv
end;

function TfrmCadCliente.ValidarCpfCnpj(const Valor: string): Boolean;
var
  Num: string;
  i, Soma, Resto: Integer;
  Peso: array[1..13] of Integer;
begin
  Result := False;

  Num := SomenteNumeros(Valor); //limpa o valor, removendo a máscara

  if (Num = '') or (Num = StringOfChar(Num[1], Length(Num))) then
  Exit;

  // se tiver 11 digitos trata como CPF
  if Length(Num) = 11 then
  begin
  //primeiro digito
    Soma := 0;
    for i := 1 to 9 do  //passa os 9 primeiros números
      Soma := Soma + StrToInt(Num[i]) * (11 - i);//transforma de texto a número, multiplica por um peso

    Resto := (Soma * 10) mod 11; //mod= divide por 11
    if Resto = 10 then Resto := 0; //verifica o resultado

    if Resto <> StrToInt(Num[10]) then Exit;   //se der 10 é 0

  //segundo digito
    Soma := 0;
    for i := 1 to 10 do
      Soma := Soma + StrToInt(Num[i]) * (12 - i);

    Resto := (Soma * 10) mod 11;
    if Resto = 10 then Resto := 0;

    if Resto <> StrToInt(Num[11]) then Exit;

    Result := True;
  end

  //se tiver 14 digitos trata como CNPJ
  else if Length(Num) = 14 then
  begin
    //lista de pesos pro digito 1
    Peso[1] := 5; Peso[2] := 4; Peso[3] := 3; Peso[4] := 2;
    Peso[5] := 9; Peso[6] := 8; Peso[7] := 7; Peso[8] := 6;
    Peso[9] := 5; Peso[10] := 4; Peso[11] := 3; Peso[12] := 2;

    Soma := 0;
    for i := 1 to 12 do //passa pelos 12 números
      Soma := Soma + StrToInt(Num[i]) * Peso[i]; //multiplica cada número pelo peso

    Resto := Soma mod 11; //divide por 11
    if Resto < 2 then Resto := 0 else Resto := 11 - Resto; // resto menor que 2 = o, senão 11-resto

    if Resto <> StrToInt(Num[13]) then Exit;

    // lista de pesos pro digito 2
    Peso[1] := 6; Peso[2] := 5; Peso[3] := 4; Peso[4] := 3;
    Peso[5] := 2; Peso[6] := 9; Peso[7] := 8; Peso[8] := 7;
    Peso[9] := 6; Peso[10] := 5; Peso[11] := 4; Peso[12] := 3;
    Peso[13] := 2;

    Soma := 0;
    for i := 1 to 13 do
      Soma := Soma + StrToInt(Num[i]) * Peso[i];

    Resto := Soma mod 11;
    if Resto < 2 then Resto := 0 else Resto := 11 - Resto;

    if Resto <> StrToInt(Num[14]) then Exit;

    Result := True;
  end;
end;

