procedure TfrmCadCliente.BuscarCEP(const CEP: string);
var
  HTTP: TIdHTTP;
  SSL: TIdSSLIOHandlerSocketOpenSSL;
  Resp: string;
  JSON: TJSONObject;
begin
  HTTP := TIdHTTP.Create(nil);
  SSL  := TIdSSLIOHandlerSocketOpenSSL.Create(nil);

  try
    //configura o ssl
    SSL.SSLOptions.Method := sslvTLSv1_2;
    SSL.SSLOptions.Mode   := sslmUnassigned;

    HTTP.IOHandler := SSL;
    HTTP.Request.UserAgent := 'Mozilla/5.0'; // evita bloqueio

    try
      //requisição
      Resp := HTTP.Get('https://viacep.com.br/ws/' + CEP + '/json/');
    except
      on E: Exception do
      begin
        ShowMessage('Erro ao buscar CEP: ' + E.Message);
        Exit;
      end;
    end;

    //valida o json
    JSON := TJSONObject.ParseJSONValue(Resp) as TJSONObject;
    if not Assigned(JSON) then
    begin
      ShowMessage('Erro ao interpretar resposta do CEP!');
      Exit;
    end;

    try
      // CEP inválido
      if JSON.GetValue('erro') <> nil then
      begin
        ShowMessage('CEP não encontrado!');
        Exit;
      end;

      //preenche os campos
      edtEndereco.Text := JSON.GetValue<string>('logradouro', '');
      edtBairro.Text   := JSON.GetValue<string>('bairro', '');
      edtCidade.Text   := JSON.GetValue<string>('localidade', '');
      edtEstado.Text   := JSON.GetValue<string>('uf', '');

    finally
      JSON.Free;
    end;

  finally
    HTTP.Free;
    SSL.Free;
  end;
end;

