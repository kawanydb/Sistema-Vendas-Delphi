procedure TfrmCadCliente.edtCpfCnpjChange(Sender: TObject);
var
  Num, Texto: string;
begin
  Num := SomenteNumeros(edtCpfCnpj.Text);
  Texto := '';

  edtCpfCnpj.OnChange := nil;

  if Length(Num) <= 11 then
  begin
    // CPF
    if Length(Num) >= 1 then
      Texto := Copy(Num,1,3);

    if Length(Num) >= 4 then
      Texto := Texto + '.' + Copy(Num,4,3);

    if Length(Num) >= 7 then
      Texto := Texto + '.' + Copy(Num,7,3);

    if Length(Num) >= 10 then
      Texto := Texto + '-' + Copy(Num,10,2);
  end
  else
  begin
    // CNPJ
    if Length(Num) >= 1 then
      Texto := Copy(Num,1,2);

    if Length(Num) >= 3 then
      Texto := Texto + '.' + Copy(Num,3,3);

    if Length(Num) >= 6 then
      Texto := Texto + '.' + Copy(Num,6,3);

    if Length(Num) >= 9 then
      Texto := Texto + '/' + Copy(Num,9,4);

    if Length(Num) >= 13 then
      Texto := Texto + '-' + Copy(Num,13,2);
  end;

  edtCpfCnpj.Text := Texto;
  edtCpfCnpj.SelStart := Length(Texto);
  edtCpfCnpj.OnChange := edtCpfCnpjChange;
end;

