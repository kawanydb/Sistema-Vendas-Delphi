  if Assigned(oUsuarioLogado) then
  begin
    oUsuarioLogado.codigo := 0; //se o usuário for = 0 (nenhum)
    oUsuarioLogado.nome   := ''; //limpa nome
    oUsuarioLogado.senha  := ''; //limpa senha
  end;

  //esconde o formulário
  Self.Hide;

  //cria a tela de login
  frmLogin := TfrmLogin.Create(Self);
  try
    frmLogin.ShowModal; //exibe
  finally
