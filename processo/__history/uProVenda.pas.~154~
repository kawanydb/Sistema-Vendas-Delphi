function TfrmProVenda.Apagar: Boolean;
begin
  if oVenda.Selecionar(QryListagem.FieldByName('vendaId').AsInteger, dtmVenda.cdsItensVenda) then begin
     Result:=oVenda.Apagar;
  end;
end;

function TfrmProVenda.Gravar(EstadoDoCadastro: TEstadoDoCadastro): Boolean;
var
  QryCliente: TFDQuery;
  StatusAtual: Integer;
begin
  Result:= False;

  if dtmVenda.cdsItensVenda.IsEmpty then
  begin
    ShowMessage('Adicione pelo menos um produto antes de gravar.');
    lkpProduto.SetFocus;
    Exit;
  end;

  if edtVendaId.Text <> EmptyStr then
    oVenda.VendaId := StrToInt(edtVendaId.Text)
  else
    oVenda.VendaId := 0;

  oVenda.ClienteId  := Integer(lkpCliente.KeyValue);
  oVenda.DataVenda  := edtDataVenda.Date;
  oVenda.TotalVenda := edtValorTotal.Value;
  Result := False;

  // Busca o statusId real do cliente selecionado no lookup
  QryCliente := TFDQuery.Create(nil);
  try
    QryCliente.Connection := dtmConexao.conexaoDB;
    QryCliente.SQL.Text := 'SELECT statusId FROM clientes WHERE clienteId = :id';
    QryCliente.ParamByName('id').AsInteger := Integer(lkpCliente.KeyValue);
    QryCliente.Open;
    StatusAtual := QryCliente.FieldByName('statusId').AsInteger;
  finally
    QryCliente.Free;
  end;

  if not PodeRealizarCompra(StatusAtual) then
  begin
    ShowMessage('Cliente não pode realizar compras (Bloqueado ou em Atenção)');
    LimparCds;                //  limpa os itens
    edtValorTotal.Value := 0; //  zera total
    Exit;
  end;

  if (EstadoDoCadastro = ecInserir) then
    oVenda.VendaId := oVenda.Inserir(dtmVenda.cdsItensVenda)
  else if EstadoDoCadastro = ecAlterar then
    oVenda.Atualizar(dtmVenda.cdsItensVenda);

  AtualizarStatusCliente(Integer(lkpCliente.KeyValue), StatusAtual);

  if Assigned(frmCadCliente) then
  begin
    frmCadCliente.QryListagem.Close;
    frmCadCliente.QryListagem.Open;
  end;


  frmRelProVenda := TfrmRelProVenda.Create(Self);

  frmRelProVenda.QryVendas.Close;
  frmRelProVenda.QryVendas.ParamByName('vendaId').AsInteger := oVenda.VendaId;
  frmRelProVenda.QryVendas.Open;

  frmRelProVenda.QryVendasItens.Close;
  frmRelProVenda.QryVendasItens.ParamByName('vendaId').AsInteger := oVenda.VendaId;
  frmRelProVenda.QryVendasItens.Open;

  frmRelProVenda.Relatorio.PreviewModal;
  frmRelProVenda.Release;

  Result := True;
end;

//testeeeeeeeeeeeeeeee
procedure TfrmProVenda.lkpClienteCloseUp(Sender: TObject);
begin
  if dbGridItens.DataSource.DataSet.RecordCount > 0 then
  begin
    if MessageDlg(
      'Ao alterar o cliente, os produtos da venda serão removidos. Deseja continuar?',
      mtConfirmation,
      [mbYes, mbNo],
      0
    ) = mrNo then
    begin
      // mantém o cliente anterior
      lkpCliente.KeyValue := QryListagem.FieldByName('clienteId').AsInteger;
      Exit;
    end;

    // se confirmou, limpa os itens da venda
    LimparCds;
    LimparComponenteItem;
    LimparEdits;

    // opcional: zerar valores totais
    edtValorTotal.Value := 0;
  end;
end;

procedure TfrmProVenda.lkpProdutoExit(Sender: TObject);
begin
  inherited;

  //arrumando pra o produto puxar seu devido preço
  if lkpProduto.KeyValue <> Null then
  begin
    if dtmVenda.QryProdutos.Locate('produtoId', lkpProduto.KeyValue, []) then
    begin
      edtValorUnitario.Value := dtmVenda.QryProdutos.FieldByName('valor').AsFloat;
      edtQuantidade.Value    := 1;
      edtTotalProduto.Value  := TotalizarProduto(edtValorUnitario.Value, edtQuantidade.Value);
    end;
  end;
end;

