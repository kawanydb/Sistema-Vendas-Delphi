procedure TfrmTelaHeranca.btnPesquisarClick(Sender: TObject);
var
  I: Integer;
  TipoCampo: TFieldType;
  NomeCampo: string;
  WhereOrAnd: string;
  CondicaoSQL: string;
  SQLSemOrder: string;
  OrderByClause: string;
  PosOrder: Integer;
begin
if QryListagem.State in [dsEdit, dsInsert] then
  QryListagem.Cancel;

  if not TUsuariologado.TenhoAcesso(
    oUsuarioLogado.codigo,
    Self.Name + '_' + TBitBtn(Sender).Name,
    dtmConexao.conexaoDB) then
  begin
    MessageDlg(
      'Usuário: ' + oUsuarioLogado.nome + ', não tem permissão de acesso',
      mtWarning, [mbOK], 0
    );
    Abort;
  end;

  // se não digitou nada
  if Trim(mskPesquisar.Text) = '' then
  begin
    QryListagem.Close;
    QryListagem.SQL.Clear;
    QryListagem.SQL.Add(SelectOriginal);
    QryListagem.Open;
    Abort;
  end;

  mskPesquisar.Text := Trim(mskPesquisar.Text);
  NomeCampo := '';
  CondicaoSQL := '';

  // procura se existe ORDER BY no SQL
  PosOrder := Pos('ORDER BY', UpperCase(SelectOriginal));

  if PosOrder > 0 then
  begin
    SQLSemOrder := Copy(SelectOriginal, 1, PosOrder - 1);
    OrderByClause := Copy(SelectOriginal, PosOrder, Length(SelectOriginal));
  end
  else
  begin
    SQLSemOrder := SelectOriginal;
    OrderByClause := '';
  end;

  // se já existe WHERE usa AND, senão usa WHERE
  if Pos('where', LowerCase(SQLSemOrder)) > 0 then
    WhereOrAnd := ' AND '
  else
    WhereOrAnd := ' WHERE ';

  // pesquisa direta por STATUS (sem depender da coluna clicada)
  if SameText(mskPesquisar.Text, 'Ativo') or
     SameText(mskPesquisar.Text, 'Inativo') or
     SameText(mskPesquisar.Text, 'Bloqueado') or
     SameText(mskPesquisar.Text, 'Atenção') or
     SameText(mskPesquisar.Text, 'Prospecto') then
  begin
    CondicaoSQL := WhereOrAnd +
                   's.descricao = ' +
                   QuotedStr(mskPesquisar.Text);

    QryListagem.Close;
    QryListagem.SQL.Clear;
    QryListagem.SQL.Add(SQLSemOrder + CondicaoSQL + ' ' + OrderByClause);
    QryListagem.Open;

    mskPesquisar.Text := '';
    mskPesquisar.SetFocus;
    Exit;
  end;

  // descobre qual campo está sendo pesquisado
for I := 0 to QryListagem.FieldCount - 1 do
begin
  if QryListagem.Fields[I].FieldName = IndiceAtual then
  begin
    if QryListagem.Fields[I].FieldName = 'statusId' then
    begin
      ShowMessage('Digite um status válido: Ativo, Inativo, Bloqueado, Atenção ou Prospecto');
      Exit;
    end;

    TipoCampo := QryListagem.Fields[I].DataType;

    if QryListagem.Fields[I].FieldName = 'pessoaDescricao' then
    begin
      NomeCampo := 'p.descricao';
      TipoCampo := ftString;
    end
    else if QryListagem.Fields[I].Origin <> '' then
      NomeCampo := QryListagem.Fields[I].Origin
    else
      NomeCampo := QryListagem.Fields[I].FieldName;

    Break;
  end;
end;

  // monta condição normal
  if (TipoCampo in [ftInteger, ftSmallint, ftAutoInc]) then
  begin
    CondicaoSQL := WhereOrAnd +
                   NomeCampo + ' = ' +
                   mskPesquisar.Text;
  end
  else if (TipoCampo in [ftString, ftWideString]) then
  begin
    CondicaoSQL := WhereOrAnd +
                   NomeCampo + ' LIKE ' +
                   QuotedStr('%' + mskPesquisar.Text + '%');
  end
  else if (TipoCampo in [ftDate, ftDateTime, ftTimeStamp]) then
  begin
    CondicaoSQL := WhereOrAnd +
                   'CAST(' + NomeCampo + ' as date) = ' +
                   QuotedStr(mskPesquisar.Text);
  end
  else if (TipoCampo in [ftFloat, ftCurrency, ftFMTBcd]) then
  begin
    CondicaoSQL := WhereOrAnd +
                   NomeCampo + ' = ' +
                   StringReplace(mskPesquisar.Text, ',', '.', [rfReplaceAll]);
  end;

  // executa a query
  QryListagem.Close;
  QryListagem.SQL.Clear;
  QryListagem.SQL.Add(SQLSemOrder + CondicaoSQL + ' ' + OrderByClause);
  QryListagem.Open;

  mskPesquisar.Text := '';
  mskPesquisar.SetFocus;
end;

