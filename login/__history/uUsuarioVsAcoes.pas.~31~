interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Data.DB, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Param,
  FireDAC.Stan.Error, FireDAC.DatS, FireDAC.Phys.Intf, FireDAC.DApt.Intf, FireDAC.Stan.Async, FireDAC.DApt,
  FireDAC.Comp.DataSet, FireDAC.Comp.Client, Vcl.Grids, Vcl.DBGrids, uDTMConexao, Vcl.StdCtrls, Vcl.Buttons;

type
  TfrmUsuarioVsAcoes = class(TForm)
    pnl1: TPanel;
    pnl2: TPanel;
    pnl3: TPanel;
    spl1: TSplitter;
    dbgrdUsuarios: TDBGrid;
    dbgrdACoes: TDBGrid;
    QryUsuario: TFDQuery;
    QryAcoes: TFDQuery;
    dtsUsuario: TDataSource;
    dtsAcoes: TDataSource;
    fdtncfldQryUsuariousuarioid: TFDAutoIncField;
    strngfldQryUsuarioNome: TStringField;
    btnnFechar: TBitBtn;
    intgrfldQryAcoesusuarioId: TIntegerField;
    intgrfldQryAcoesacaoAcessoId: TIntegerField;
    strngfldQryAcoesdescricao: TStringField;
    blnfldQryAcoesativo: TBooleanField;
    procedure btnnFecharClick(Sender: TObject);
