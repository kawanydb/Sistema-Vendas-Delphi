  object QryVenda: TFDQuery
    Active = True
    Connection = dtmConexao.conexaoDB
    SQL.Strings = (
      'SELECT vendas.vendaId,'
      '       vendas.clienteId,'
      '       clientes.nome,'
      '       vendas.dataVenda,'
      '       cast(vendas.totalVenda as numeric(18,3)) as TotalVenda'
      '  FROM vendas'
      
        '       INNER JOIN clientes on clientes.clienteId = vendas.client' +
        'eId'
      ' WHERE vendas.dataVenda BETWEEN :DataInicio AND :DataFim'
      ' ORDER BY vendas.dataVenda, vendas.clienteId'
      ''
      ''
      '')
    Left = 440
    Top = 362
    ParamData = <
      item
        Name = 'DATAINICIO'
        DataType = ftDate
        ParamType = ptInput
        Value = 46082d
      end
      item
        Name = 'DATAFIM'
        DataType = ftDate
        ParamType = ptInput
        Value = '31/03/2026'
      end>
